# D2 — envío del informe por email (OPT-IN).
# Copia este archivo como .env y rellena los 5 valores para activarlo:
#     cp .env.example .env
# Con .env ausente o incompleto → modo demo: el PDF se guarda y NO se envía nada.
# (.env está en .gitignore — no lo commitees jamás)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_DEST=